{
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run typecheck*)",
      "Bash(npm test*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(node .claude/hooks/context-head.mjs*)",
      "Bash(node .claude/hooks/docs-check.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(./.env.development)",
      "Read(**/.env.development)",
      "Read(./.env.staging)",
      "Read(**/.env.staging)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(./.env.test)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Read(./backups/**)",
      "Read(**/*.dump)",
      "Read(**/*.backup)",
      "Bash(npx supabase db push*)",
      "Bash(supabase db push*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(npx vercel --prod*)",
      "Bash(vercel --prod*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(gh repo create*)",
      "Bash(gh repo edit*)",
      "Bash(npx vercel*)",
      "Bash(vercel*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/context-head.mjs" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/bash-guards.mjs" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/protect-config.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/post-edit-check.mjs" }
        ]
      }
    ]
  }
}
