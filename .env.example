# Names only. Never put a real value in this file (D-002, D-015).
# Copy to .env.local for development; real values live only in each environment's secret store.

# dev | staging | production
APP_ENV=
# Public base URL of this environment, e.g. http://localhost:3000
APP_BASE_URL=

# Database: any Postgres (D-002). Leave empty in dev to use the in-process PGlite database.
DATABASE_URL=

# Payments: provider behind an adapter; sandbox only until LLP + KYC (D-003)
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Email alerts for new queries (D-006). "console" transport in dev.
EMAIL_TRANSPORT=
EMAIL_FROM=
EMAIL_TEAM_INBOX=
EMAIL_API_KEY=

# Staff admin auth (D-006)
ADMIN_AUTH_SECRET=
